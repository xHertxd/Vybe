# Frontend (client/) — copy to client/.env
# Leave empty for local development (the Vite proxy forwards to the backend)
# and when the Node server also serves client/dist.
# Set only when the backend lives on another origin, e.g. https://api.example.com
VITE_SERVER_URL=

# Spotify PKCE client ID. Must match SPOTIFY_CLIENT_ID on the server.
# Add <your-app-origin>/ as a Redirect URI in the Spotify developer dashboard.
VITE_SPOTIFY_CLIENT_ID=
