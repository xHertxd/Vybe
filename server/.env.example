# Backend (server/) — copy to server/.env
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Optional comma-separated allow-list for browser origins.
# Leave empty for local development. Set it in production.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional YouTube Data API v3 key. Without it, YouTube search is disabled.
# Get one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Optional Spotify client credentials (client credentials flow).
# Metadata still resolves through public oEmbed without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional FreeToUse API base URL. Change if using a proxy or mirror.
FREETOUSE_API_URL=https://api.freetouse.com/v3

# Sync + room tuning (milliseconds unless noted)
DISCONNECT_GRACE_MS=25000
SYNC_SCHEDULE_DELAY_MS=600
SYNC_HEARTBEAT_MS=5000
ROOM_IDLE_TIMEOUT_MS=43200000
MAX_USERS_PER_ROOM=50
MAX_QUEUE_LENGTH=200
UPLOAD_MAX_BYTES=31457280