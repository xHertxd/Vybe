# Backend (server/) — copy to server/.env
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional: YouTube Data API v3 (playlist metadata). RSS fallback is used without it.
YOUTUBE_API_KEY=

# Optional: Spotify client credentials (richer album/playlist metadata).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

DISCONNECT_GRACE_MS=25000
SYNC_SCHEDULE_DELAY_MS=600
SYNC_HEARTBEAT_MS=5000
ROOM_IDLE_TIMEOUT_MS=43200000
MAX_USERS_PER_ROOM=50
MAX_QUEUE_LENGTH=200
UPLOAD_MAX_BYTES=31457280
