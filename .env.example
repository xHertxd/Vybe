# ---------------------------------------------------------------------------
# Vybe — unified environment reference
#
# Local development uses two files:
#   server/.env   (backend)
#   client/.env   (Vite frontend)
# Copy the matching example file in each folder.
# ---------------------------------------------------------------------------

# ------------------------------- Backend -----------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Optional comma-separated allow-list for browser origins.
# Leave empty for local development. Set it in production.
# ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional YouTube Data API v3 key. Without it, Vybe uses public playlist
# feeds and videos still play through the IFrame API.
YOUTUBE_API_KEY=

# Optional Spotify server credentials (client credentials flow).
# Metadata still resolves through public oEmbed without these.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Sync + room tuning (milliseconds unless noted)
DISCONNECT_GRACE_MS=25000
SYNC_SCHEDULE_DELAY_MS=600
SYNC_HEARTBEAT_MS=5000
ROOM_IDLE_TIMEOUT_MS=43200000
MAX_USERS_PER_ROOM=50
MAX_QUEUE_LENGTH=200
UPLOAD_MAX_BYTES=31457280

# ------------------------------- Frontend ----------------------------------
# Point the built client at a deployed backend on a different origin. Leave
# empty for local development and when one Node process serves both the API
# and the client build.
VITE_SERVER_URL=

# Same client ID as the server. Used for Spotify PKCE + Web Playback SDK.
# Add <your-app-origin>/ as a Redirect URI in the Spotify developer dashboard.
VITE_SPOTIFY_CLIENT_ID=
